PORT=5000

# MongoDB Atlas Connection
# Obtenez votre URI depuis MongoDB Atlas:
# 1. Connectez-vous à https://cloud.mongodb.com
# 2. Cliquez sur "Connect" sur votre cluster
# 3. Choisissez "Connect your application"
# 4. Copiez l'URI et remplacez <password> par votre mot de passe
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/larosa?retryWrites=true&w=majority

JWT_SECRET=votre_secret_jwt_ici

# Site Information
SITE_NAME=La Rosa Pâtisserie
SITE_URL=https://www.larosa.tn
CONTACT_EMAIL=larosa.korba@gmail.com
CONTACT_PHONE=+216 22 644 528

# Social Auth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Paymee Configuration
PAYMEE_API_KEY=your_paymee_api_key_here
PAYMEE_ENV=sandbox
